const { variant = "default", showAi = true } = Astro.props;
const config = configs[variant];
const selectedSpan = config.spans.find((item) => item.id === config.opportunityId) ?? config.spans[0];
const maxDepth = Math.max(...config.spans.map((item) => item.depth));
const rows = Array.from({ length: maxDepth + 1 }, (_, index) => index);
const timelinePoints = [0, 0.25, 0.5, 0.75, 1];
const demoId = `flame-demo-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const detailId = `${demoId}-detail`;
const pickerId = `${demoId}-picker`;
const titleId = `${demoId}-title`;
const opportunityTitleId = `${demoId}-opportunity-title`;
const hasInsights = Astro.slots.has("insights");
const verificationReduction = Math.round(
  ((config.verification.baseline - config.verification.after) / config.verification.baseline) * 100,
);

const typeLabels: Record<SpanType, string> = {
  php: "Observed runtime",
  core: "WordPress lifecycle",
  plugin: "Plugin",
  theme: "Theme",
  db: "Database",
  ext: "WordPress HTTP API",
};

const capabilities = [
  {
    label: "Early lifecycle",
    status: "Captured",
    statusClass: "captured",
    detail: "Observed from the earliest WP Flame bootstrap represented by this fixture.",
  },
  {
    label: "Database",
    status: "Captured",
    statusClass: "captured",
    detail: "Supported spans after database capture registration; earlier queries are not implied.",
  },
  {
    label: "WordPress HTTP API",
    status: "Captured",
    statusClass: "captured",
    detail: "Supported WordPress HTTP API activity only.",
  },
  {
    label: "Hook callbacks",
    status: "Not requested",
    statusClass: "not-requested",
    detail: "Standard mode does not provide callback-level detail. Use a one-shot Deep capture.",
  },
  {
    label: "Cache counters",
    status: "Unavailable",
    statusClass: "unavailable",
    detail: "Unknown in this fixture; unavailable never means zero.",
  },
];
---

<section
  class="demo-window reveal"
  data-flame-demo
  data-variant={variant}
  aria-labelledby={titleId}
>
  <div class="demo-toolbar" aria-hidden="true">
    <div class="demo-dot"></div>
    <div class="demo-dot"></div>
    <div class="demo-dot"></div>
    <div class="demo-url">yoursite.com/wp-admin/tools.php?page=wp-flame</div>
  </div>

  <div class="sample-notice" role="note">
    <span>Illustrative product preview</span>
    Bundled example data only — not a live customer trace, benchmark, or promise of
    identical telemetry on every host.
  </div>

  <div class="demo-body">
    <header class="demo-header">
      <div>
        <p class="demo-eyebrow">Bounded request capture</p>
        <h3 class="demo-title" id={titleId}>Supported measured spans</h3>
      </div>
      <div class="demo-req">
        <span>{config.requestType}</span>
        <strong>{config.method} {config.route}</strong>
        <span>HTTP {config.status}</span>
      </div>
    </header>

    <div class="capture-context" aria-label="Illustrative capture context">
      <div class="context-item">
        <span>Capture mode</span>
        <strong>Standard</strong>
        <small>Manual · bounded to 1 request</small>
      </div>
      <div class="context-item">
        <span>Completeness</span>
        <strong class="partial">Partial</strong>
        <small>Cache counters unavailable</small>
      </div>
      <div class="context-item">
        <span>Capture start</span>
        <strong>Early WP bootstrap</strong>
        <small>Not absolute server start</small>
      </div>
      <div class="context-item">
        <span>Observation</span>
        <strong>1 sample</strong>
        <small>Directional, not verified</small>
      </div>
    </div>

    <div class="demo-stats" aria-label="Illustrative measured summary">
      <div class="demo-stat">
        <span>Observed duration</span>
        <strong>{config.observedDuration}<small>ms</small></strong>
      </div>
      <div class="demo-stat">
        <span>Recorded DB spans</span>
        <strong>{config.dbSpans}<small>{config.dbTime}ms</small></strong>
      </div>
      <div class="demo-stat">
        <span>Recorded HTTP spans</span>
        <strong>{config.httpSpans}<small>{config.httpTime}ms</small></strong>
      </div>
      <div class="demo-stat">
        <span>Dropped spans</span>
        <strong>0<small>in this fixture</small></strong>
      </div>
    </div>

    <details class="capability-panel" open>
      <summary>Capture capability and completeness</summary>
      <p class="capability-explainer">
        Partial means the recorded spans remain useful, while unavailable telemetry stays
        explicitly unknown. Standard mode is not arbitrary function-level PHP profiling.
      </p>
      <div class="capability-grid">
        {
          capabilities.map((capability) => (
            <div class="capability-item">
              <div>
                <strong>{capability.label}</strong>
                <span class={`capability-status ${capability.statusClass}`}>
                  {capability.status}
                </span>
              </div>
              <p>{capability.detail}</p>
            </div>
          ))
        }
      </div>
    </details>

    <section class="graph-section" aria-labelledby={`${demoId}-graph-title`}>
      <div class="graph-header">
        <div>
          <h4 id={`${demoId}-graph-title`}>Observed request timeline</h4>
          <p>Select any measured span to inspect its evidence and a cautious next action.</p>
        </div>
        <div class="span-picker">
          <label for={pickerId}>Explore a span</label>
          <select id={pickerId} data-span-picker>
            {
              config.spans.map((item) => (
                <option value={item.id} selected={item.id === selectedSpan.id}>
                  {item.name} — {item.duration}ms
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <div class="demo-legend" aria-label="Span categories">
        <span><i class="legend-core"></i>Lifecycle</span>
        <span><i class="legend-plugin"></i>Plugin</span>
        <span><i class="legend-theme"></i>Theme</span>
        <span><i class="legend-db"></i>Database</span>
        <span><i class="legend-ext"></i>HTTP API</span>
      </div>

      <p class="scroll-hint">
        On smaller screens, use the span selector above or swipe the timeline horizontally.
      </p>

      <div
        class="graph-scroller"
        tabindex="0"
        role="group"
        aria-label="Scrollable illustrative flame graph. Use the span buttons or the span selector."
      >
        <div class="flame-canvas">
          <div class="flame-timeline" aria-hidden="true">
            {
              timelinePoints.map((point) => (
                <span style={`left:${point * 100}%`}>
                  {Math.round(config.observedDuration * point)}ms
                </span>
              ))
            }
          </div>

          <div class="flame-rows">
            {
              rows.map((depth) => (
                <div class="flame-row" aria-label={`Span depth ${depth + 1}`}>
                  {config.spans
                    .filter((item) => item.depth === depth)
                    .map((item) => {
                      const left = (item.start / config.observedDuration) * 100;
                      const width = (item.duration / config.observedDuration) * 100;
                      const percent = Math.round(width);
                      return (
                        <button
                          type="button"
                          class={`f-block f-${item.type}`}
                          style={`left:${left}%;width:${width}%`}
                          data-span-id={item.id}
                          data-name={item.name}
                          data-duration={`${item.duration}ms`}
                          data-percent={`${percent}%`}
                          data-type={typeLabels[item.type]}
                          data-owner={item.owner}
                          data-capability={item.capability}
                          data-evidence={item.evidence}
                          data-next-action={item.nextAction}
                          aria-controls={detailId}
                          aria-pressed={item.id === selectedSpan.id ? "true" : "false"}
                          aria-label={`${item.name}, ${item.duration} milliseconds, ${percent} percent of observed request, ${typeLabels[item.type]}. Show evidence.`}
