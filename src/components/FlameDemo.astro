---
interface Props {
  variant?: "default" | "woocommerce" | "elementor" | "agency";
  /** Kept for backwards compatibility. This now controls only a supplied legacy insights slot. */
  showAi?: boolean;
}

type Variant = NonNullable<Props["variant"]>;
type SpanType = "php" | "core" | "plugin" | "theme" | "db" | "ext";

interface TraceSpan {
  id: string;
  name: string;
  type: SpanType;
  depth: number;
  start: number;
  duration: number;
  owner: string;
  capability: string;
  evidence: string;
  nextAction: string;
}

interface TraceConfig {
  route: string;
  requestType: string;
  method: string;
  status: number;
  observedDuration: number;
  dbTime: number;
  dbSpans: number;
  httpTime: number;
  httpSpans: number;
  opportunityId: string;
  verification: {
    baseline: number;
    after: number;
    baselineSamples: number;
    afterSamples: number;
  };
  spans: TraceSpan[];
}

const span = (
  id: string,
  name: string,
  type: SpanType,
  depth: number,
  start: number,
  duration: number,
  owner: string,
  capability: string,
  evidence: string,
  nextAction: string,
): TraceSpan => ({
  id,
  name,
  type,
  depth,
  start,
  duration,
  owner,
  capability,
  evidence,
  nextAction,
});

