  .verification-result strong {
    flex-shrink: 0;
    color: var(--insight-300);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
  }
  .verification-result span {
    color: var(--carbon-400);
    font-size: 10px;
    line-height: 1.45;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .capture-context,
    .demo-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .context-item:nth-child(2) { border-right: 0; }
    .context-item:nth-child(-n + 2) { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
    .graph-header { align-items: stretch; flex-direction: column; gap: 12px; }
    .span-picker { align-items: stretch; width: 100%; }
  }

  @media (max-width: 640px) {
    .demo-window { border-radius: 12px; }
    .demo-toolbar { padding: 11px 14px; }
    .demo-url { margin-left: 4px; padding-inline: 9px; }
    .sample-notice { align-items: flex-start; flex-direction: column; gap: 7px; padding: 11px 16px; }
    .demo-body { padding: 20px 16px; }
    .demo-header { align-items: flex-start; flex-direction: column; gap: 10px; }
    .demo-req { align-items: flex-start; text-align: left; }
    .capture-context,
    .demo-stats { grid-template-columns: 1fr 1fr; }
    .context-item,
    .demo-stat { padding: 11px; }
    .capability-grid { grid-template-columns: 1fr; }
    .scroll-hint { display: block; }
    .flame-canvas { min-width: 620px; }
    .detail-heading { align-items: flex-start; flex-direction: column; gap: 9px; }
    .detail-facts,
    .detail-guidance { grid-template-columns: 1fr; }
    .opportunities-header,
    .verification-header { align-items: flex-start; flex-direction: column; gap: 7px; }
    .opportunities-header > span,
    .verification-header > span { text-align: left; }
    .verification-row { grid-template-columns: 1fr; gap: 7px; }
    .verification-result { align-items: flex-start; flex-direction: column; gap: 5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-window :global(.f-block) { transition: none; }
    .demo-window :global(.f-block:hover) { transform: none; }
  }
</style>

<script>
  const initialiseFlameDemos = () => {
    document.querySelectorAll<HTMLElement>("[data-flame-demo]:not([data-initialized])").forEach((root) => {
      root.dataset.initialized = "true";

      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-span-id]"));
      const picker = root.querySelector<HTMLSelectElement>("[data-span-picker]");
      const detail = root.querySelector<HTMLElement>(".detail-panel");
      const liveStatus = root.querySelector<HTMLElement>("[data-live-status]");

      const detailFields = {
        name: root.querySelector<HTMLElement>("[data-detail-name]"),
        duration: root.querySelector<HTMLElement>("[data-detail-duration]"),
        percent: root.querySelector<HTMLElement>("[data-detail-percent]"),
        type: root.querySelector<HTMLElement>("[data-detail-type]"),
        owner: root.querySelector<HTMLElement>("[data-detail-owner]"),
        capability: root.querySelector<HTMLElement>("[data-detail-capability]"),
        evidence: root.querySelector<HTMLElement>("[data-detail-evidence]"),
        action: root.querySelector<HTMLElement>("[data-detail-action]"),
      };

      const setText = (element: HTMLElement | null, value: string | undefined) => {
        if (element) element.textContent = value ?? "";
      };

      const selectSpan = (button: HTMLButtonElement, shouldScroll = false) => {
        buttons.forEach((candidate) => {
          candidate.setAttribute("aria-pressed", candidate === button ? "true" : "false");
        });

        setText(detailFields.name, button.dataset.name);
        setText(detailFields.duration, button.dataset.duration);
        setText(detailFields.percent, button.dataset.percent);
        setText(detailFields.type, button.dataset.type);
        setText(detailFields.owner, button.dataset.owner);
        setText(detailFields.capability, button.dataset.capability);
        setText(detailFields.evidence, button.dataset.evidence);
        setText(detailFields.action, button.dataset.nextAction);

        if (picker && button.dataset.spanId) picker.value = button.dataset.spanId;
        if (liveStatus) {
          liveStatus.textContent = `${button.dataset.name ?? "Span"} selected. ${button.dataset.duration ?? ""}, ${button.dataset.percent ?? ""} of observed request. Evidence and likely next action updated.`;
        }

        window.dispatchEvent(new CustomEvent("wpflame:commercial-event", {
          detail: {
            event: "sample_trace_span_opened",
            properties: {
              variant: root.dataset.variant,
              span_id: button.dataset.spanId,
            },
          },
        }));

        if (shouldScroll && detail && window.matchMedia("(max-width: 640px)").matches) {
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          detail.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
        }
      };

      buttons.forEach((button, index) => {
        button.addEventListener("click", () => selectSpan(button, true));
        button.addEventListener("keydown", (event) => {
          let targetIndex: number | null = null;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            targetIndex = (index + 1) % buttons.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            targetIndex = (index - 1 + buttons.length) % buttons.length;
          } else if (event.key === "Home") {
            targetIndex = 0;
          } else if (event.key === "End") {
            targetIndex = buttons.length - 1;
          }

          if (targetIndex !== null) {
            event.preventDefault();
            const target = buttons[targetIndex];
            target.focus();
            selectSpan(target);
          }
        });
      });

      picker?.addEventListener("change", () => {
        const target = buttons.find((button) => button.dataset.spanId === picker.value);
        if (target) selectSpan(target, true);
      });
    });
  };

  initialiseFlameDemos();
  document.addEventListener("astro:page-load", initialiseFlameDemos);
</script>
