---
interface Props {
  severity: "high" | "medium" | "low";
  title: string;
  body: string;
  action: string;
}
const { severity, title, body, action } = Astro.props;
---

<div class="ai-insight">
  <div class={`ai-severity ${severity}`}></div>
  <div class="ai-insight-body">
    <h4>{title}</h4>
    <p set:html={body} />
    <span class="ai-action">→ {action}</span>
  </div>
</div>

<style>
  .ai-insight {
    background: rgba(123, 92, 255, 0.04);
    border: 1px solid rgba(123, 92, 255, 0.12);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 10px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    transition: border-color 0.3s;
  }
  .ai-insight:hover {
    border-color: rgba(123, 92, 255, 0.25);
  }
  .ai-severity {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .ai-severity.high {
    background: var(--ember-400);
  }
  .ai-severity.medium {
    background: var(--flame-400);
  }
  .ai-severity.low {
    background: var(--insight-400);
  }
  .ai-insight-body h4 {
    font-size: 13px;
    font-weight: 600;
    color: white;
    margin-bottom: 3px;
  }
  .ai-insight-body p {
    font-size: 12px;
    color: var(--carbon-300);
    line-height: 1.5;
    margin: 0;
  }
  .ai-insight-body :global(code) {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ai-300);
    background: rgba(123, 92, 255, 0.08);
    padding: 2px 5px;
    border-radius: 3px;
  }
  .ai-action {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ai-300);
    margin-top: 6px;
    display: inline-block;
  }
</style>
