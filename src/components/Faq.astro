---
interface FaqItem { question: string; answer: string; }
interface Props { audience?: 'woocommerce' | 'agency' | 'pagebuilder'; }
const { audience } = Astro.props;

const shared: FaqItem[] = [
  {
    question: 'Does WP Flame make a WordPress site faster automatically?',
    answer: 'No. WP Flame is a diagnosis and verification product. It is intended to identify supported measured contributors, recommend a safe next action, and help check the result. Public v1 will not rewrite code, change settings, disable plugins, cache pages, or optimise assets automatically.',
  },
  {
    question: 'What part of a request can it observe?',
    answer: 'WP Flame measures observed WordPress server execution from its earliest available bootstrap point. Depending on capture mode and compatibility, a trace may include supported lifecycle work, WordPress HTTP API calls, compatible database activity, and focused WordPress callback spans. It is not the web server request start and is not a complete arbitrary PHP call stack.',
  },
  {
    question: 'Will profiling add overhead?',
    answer: 'Every profiler adds some work. WP Flame is being designed around bounded capture and mode-specific limits, with focused Deep diagnostics reserved for short investigations. Fixed overhead claims will not be published until dated, reproducible evidence is available.',
  },
  {
    question: 'How is this different from Query Monitor?',
    answer: 'Query Monitor is an excellent developer tool for inspecting the current WordPress request. WP Flame’s intended public-v1 difference is retained bounded evidence, guided diagnosis, visible capture capability, compatible before-and-after comparison, and an agency-friendly handoff workflow.',
  },
  {
    question: 'Where does trace data go?',
    answer: 'The launch direction is local-first: trace data remains in the WordPress installation by default. Any future licensing, analytics, hosted report, or fleet service must be separately disclosed and consented to. Design-partner trace review also requires explicit site-specific authorisation.',
  },
  {
    question: 'Can I install the public plugin now?',
    answer: 'Not yet. WP Flame is in a paid design-partner phase while measurement correctness, operational safety, compatibility, evidence, and release gates are completed. The current call to action is to apply with a real eligible workflow or explore the illustrative sample trace.',
  },
];

const extras: Record<string, FaqItem[]> = {
  woocommerce: [{ question: 'Does this replace WooCommerce caching or optimisation?', answer: 'No. Caching and front-end optimisation remain valuable. WP Flame is intended for eligible dynamic WooCommerce work that still executes WordPress, such as cart, checkout, account, payment, shipping, or background operations. Named extension compatibility will be published only after it is tested.' }],
  agency: [{ question: 'Can I use a client trace in a report or case study?', answer: 'Only with the appropriate permission. Every client production site requires separate authorisation for installation and trace review. Publishing trace data, a testimonial, research notes, or a case study requires separate, specific consent.' }],
  pagebuilder: [{ question: 'Does this guarantee page-builder attribution?', answer: 'No. WP Flame can attribute supported observed spans to the best available WordPress owner. Exact detail depends on capture mode, code path, and compatibility. It does not measure browser rendering or guarantee visibility into every internal page-builder operation.' }],
};

const items = [...shared, ...(audience ? extras[audience] ?? [] : [])];
---

<div class="faq-section reveal">
  <div class="faq-header">
    <div class="label">FAQ</div>
    <h2 class="sec-title">Direct answers, including the limits.</h2>
  </div>
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
})} />

<style>
  .faq-section { max-width: 820px; margin: 0 auto; padding-inline: 20px; }
  .faq-header { text-align: center; margin-bottom: 46px; }
  .faq-list { display: grid; gap: 9px; }
  .faq-item { border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(255,255,255,.025); overflow: clip; }
  .faq-item[open] { border-color: rgba(240,122,24,.24); }
  .faq-item summary { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 19px 22px; color: white; font-weight: 700; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--flame-300); font: 500 20px 'JetBrains Mono',monospace; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--carbon-200); padding: 0 22px 22px; font-size: 14px; line-height: 1.7; }
</style>
