---
interface Props { src?: string; poster?: string; }
const { src, poster } = Astro.props;
---

<section class="section proof-media-section">
  <div class="container">
    <div class="proof-media-header reveal">
      <div class="label">Product walkthrough</div>
      <h2 class="sec-title">See the capture, evidence, and verification workflow.</h2>
    </div>
    {src ? (
      <video class="video-player reveal" controls preload="metadata" poster={poster}>
        <source src={src} />
        Your browser does not support the video element.
      </video>
    ) : (
      <div class="sample-link-card reveal">
        <div>
          <span>Interactive alternative</span>
          <h3>Explore the sample trace now.</h3>
          <p>The sample is available without an installation and clearly labels its illustrative data and measurement limits.</p>
        </div>
        <a href="/sample-trace/" class="btn-primary">Open the sample trace</a>
      </div>
    )}
  </div>
</section>

<style>
  .proof-media-header { max-width: 720px; margin-bottom: 42px; }
  .video-player { width: 100%; max-width: 960px; display: block; margin: 0 auto; border-radius: 16px; }
  .sample-link-card { display: flex; justify-content: space-between; align-items: center; gap: 40px; max-width: 960px; margin: 0 auto; padding: 38px; border: 1px solid rgba(255,255,255,.08); border-radius: 16px; background: rgba(255,255,255,.025); }
  .sample-link-card span { color: var(--flame-300); font: 600 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .sample-link-card h3 { color: white; font-size: 25px; margin: 12px 0 8px; }
  .sample-link-card p { color: var(--carbon-300); max-width: 620px; }
  @media (max-width: 720px) { .sample-link-card { align-items: flex-start; flex-direction: column; padding: 28px; } }
</style>
