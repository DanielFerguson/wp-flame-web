---
interface Principle { value: string; label: string; }
interface Props { stats?: Principle[]; }

const { stats = [
  { value: 'Local-first', label: 'trace data stays on the site by default' },
  { value: 'Bounded', label: 'capture and retention have explicit limits' },
  { value: 'Capability-aware', label: 'unavailable telemetry is shown as unknown' },
] } = Astro.props;
---

<div class="trust-bar reveal" aria-label="WP Flame product principles">
  {stats.map((stat) => (
    <div class="trust-stat">
      <span class="trust-value">{stat.value}</span>
      <span class="trust-label">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .trust-bar { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1px; max-width: 980px; margin: 0 auto; overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.08); }
  .trust-stat { padding: 26px; background: var(--carbon-800); }
  .trust-value { display: block; color: white; font-size: 16px; font-weight: 700; margin-bottom: 7px; }
  .trust-label { color: var(--carbon-300); font-size: 12px; line-height: 1.5; }
  @media (max-width: 700px) { .trust-bar { grid-template-columns: 1fr; } }
</style>
