---
interface Row {
  feature: string;
  wpflame: string;
  querymonitor: string;
  newrelic: string;
  blackfire: string;
}

const rows: Row[] = [
  { feature: "Visual flame graphs",    wpflame: "Free",       querymonitor: "No",      newrelic: "Paid",    blackfire: "Paid"    },
  { feature: "Per-plugin attribution", wpflame: "Free",       querymonitor: "Partial", newrelic: "No",      blackfire: "No"      },
  { feature: "AI recommendations",     wpflame: "From $29/mo",querymonitor: "No",      newrelic: "No",      blackfire: "No"      },
  { feature: "Self-hosted data",       wpflame: "Yes",        querymonitor: "Yes",     newrelic: "No",      blackfire: "No"      },
  { feature: "PHP extension required", wpflame: "No",         querymonitor: "No",      newrelic: "Yes",     blackfire: "Yes"     },
  { feature: "Real-time profiling",    wpflame: "Yes",        querymonitor: "Yes",     newrelic: "No",      blackfire: "Yes"     },
  { feature: "Trace history",          wpflame: "Free",       querymonitor: "No",      newrelic: "Paid",    blackfire: "Paid"    },
  { feature: "Starting price",         wpflame: "Free",       querymonitor: "Free",    newrelic: "~$99/mo", blackfire: "~$23/mo" },
];

function cellClass(value: string, isWpFlame: boolean): string {
  if (isWpFlame && (value === "Free" || value === "Yes" || value === "No")) return "cell-positive";
  if (value === "No") return "cell-negative";
  if (value === "Partial" || value === "Paid" || value.startsWith("From") || value.startsWith("~")) return "cell-neutral";
  return "";
}
---

<section class="section" id="compare">
  <div class="container">
    <div class="compare-header reveal">
      <div class="label">Comparison</div>
      <h2 class="sec-title">How WP Flame <em>compares</em></h2>
    </div>

    <div class="table-wrapper reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th class="col-feature">Feature</th>
            <th class="col-wpflame">
              <span class="col-brand">WP Flame</span>
            </th>
            <th>Query Monitor</th>
            <th>New Relic</th>
            <th>Blackfire</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="col-feature">{row.feature}</td>
              <td class={`col-wpflame ${cellClass(row.wpflame, true)}`}>{row.wpflame}</td>
              <td class={cellClass(row.querymonitor, false)}>{row.querymonitor}</td>
              <td class={cellClass(row.newrelic, false)}>{row.newrelic}</td>
              <td class={cellClass(row.blackfire, false)}>{row.blackfire}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.03);
    font-size: 14px;
    min-width: 640px;
  }

  /* Header row */
  .compare-table thead tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .compare-table th {
    padding: 18px 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--carbon-400);
    text-align: left;
    white-space: nowrap;
  }

  /* WP Flame column header */
  .compare-table th.col-wpflame {
    color: var(--flame-400);
    border-left: 2px solid var(--flame-400);
  }

  .col-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Feature label column */
  .compare-table th.col-feature,
  .compare-table td.col-feature {
    color: var(--carbon-300);
    font-weight: 500;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    text-transform: none;
    letter-spacing: 0;
    min-width: 200px;
  }

  .compare-table th.col-feature {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--carbon-400);
  }

  /* Body rows */
  .compare-table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.15s;
  }

  .compare-table tbody tr:last-child {
    border-bottom: none;
  }

  .compare-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .compare-table td {
    padding: 16px 20px;
    color: var(--carbon-300);
    vertical-align: middle;
    white-space: nowrap;
  }

  /* WP Flame column body cells */
  .compare-table td.col-wpflame {
    border-left: 2px solid var(--flame-400);
    background: rgba(255, 150, 50, 0.04);
    font-weight: 600;
  }

  /* Cell value states */
  .cell-positive {
    color: var(--insight-400) !important;
  }

  .cell-negative {
    color: var(--carbon-500) !important;
  }

  .cell-neutral {
    color: var(--carbon-300) !important;
  }

  @media (max-width: 900px) {
    .compare-table th,
    .compare-table td {
      padding: 14px 16px;
    }
  }
</style>
