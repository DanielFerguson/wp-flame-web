---
import { links } from '../config/links';
---

<footer class="footer">
  <div class="footer-logo">
    <svg viewBox="0 0 56 62" fill="none" width="22" height="22"
      ><rect x="0" y="48" width="56" height="11" rx="3.5" fill="#FF9632"
      ></rect><rect x="5" y="35" width="46" height="11" rx="3.5" fill="#F07A18"
      ></rect><rect x="10" y="22" width="36" height="11" rx="3.5" fill="#E84D30"
      ></rect><rect x="16" y="9" width="24" height="11" rx="3.5" fill="#C23520"
      ></rect></svg
    >
    <span>WP <em>Flame</em></span>
  </div>
  <div class="footer-links">
    <a href={links.github}>GitHub</a>
    <a href={links.wordpressOrg}>WordPress.org</a>
    <a href="/privacy">Privacy</a><a href="/terms">Terms</a>
  </div>
  <div class="footer-copy">
    WP Flame is open source software. The core APM is free forever. AI insights
    require a subscription.
  </div>
</footer>

<style>
  .footer {
    padding: 60px 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    text-align: center;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .footer-logo span {
    font-weight: 700;
    font-size: 15px;
    color: var(--carbon-300);
  }
  .footer-logo span em {
    font-style: normal;
    color: var(--flame-500);
  }
  .footer-links {
    display: flex;
    gap: 28px;
    justify-content: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-size: 13px;
    color: var(--carbon-400);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--carbon-200);
  }
  .footer-copy {
    font-size: 12px;
    color: var(--carbon-500);
  }
</style>
