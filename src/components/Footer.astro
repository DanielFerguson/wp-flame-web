---
const year = new Date().getFullYear();
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_COMMERCIAL_EVENTS_ENDPOINT?.trim());

const footerGroups = [
  {
    title: 'Product',
    links: [
      { label: 'How it works', href: '/product/' },
      { label: 'Sample trace', href: '/sample-trace/' },
      { label: 'Compatibility', href: '/compatibility/' },
      { label: 'Community vs Pro', href: '/community-vs-pro/' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Quickstart', href: '/docs/quickstart/' },
      { label: 'Use cases', href: '/use-cases/' },
      { label: 'Benchmarks', href: '/benchmarks/' },
      { label: 'Changelog', href: '/changelog/' },
    ],
  },
  {
    title: 'Trust & support',
    links: [
      { label: 'Support', href: '/support/' },
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Design partner', href: '/design-partner/' },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="WP Flame home">
        <svg viewBox="0 0 56 62" fill="none" width="27" height="30" aria-hidden="true">
          <rect x="0" y="48" width="56" height="11" rx="3.5" fill="#FF9632"></rect>
          <rect x="5" y="35" width="46" height="11" rx="3.5" fill="#F07A18"></rect>
          <rect x="10" y="22" width="36" height="11" rx="3.5" fill="#E84D30"></rect>
          <rect x="16" y="9" width="24" height="11" rx="3.5" fill="#C23520"></rect>
        </svg>
        <span>WP <em>Flame</em></span>
      </a>
      <p>
        Measured evidence for slow, dynamic WordPress workflows — from capture
        to a change you can verify.
      </p>
      <div class="footer-status">
        <span aria-hidden="true"></span>
        Pre-release · design partners welcome
      </div>
    </div>

    <nav class="footer-navigation" aria-label="Footer navigation">
      {footerGroups.map((group) => (
        <div class="footer-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© {year} WP Flame.</p>
    <p>
      Capture coverage varies by environment, workflow, and capture mode. WP Flame
      reports the evidence it observed.
    </p>
    {analyticsEnabled && (
      <button type="button" class="analytics-choice" data-analytics-choices>Analytics choices</button>
    )}
  </div>
</footer>

<style>
  .footer {
    padding: 72px clamp(20px, 4vw, 48px) 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background:
      radial-gradient(circle at 12% 0%, rgba(240, 122, 24, 0.08), transparent 28%),
      #0b0a0f;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(240px, 1.15fr) minmax(480px, 1.85fr);
    gap: clamp(56px, 8vw, 112px);
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .footer-brand {
    max-width: 360px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    color: white;
    text-decoration: none;
  }

  .footer-logo span {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-logo em {
    color: var(--flame-400);
    font-style: normal;
  }

  .footer-brand p {
    margin-top: 18px;
    color: var(--carbon-300);
    font-size: 15px;
    line-height: 1.7;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 24px;
    padding: 7px 11px;
    border: 1px solid rgba(240, 122, 24, 0.2);
    border-radius: 999px;
    background: rgba(240, 122, 24, 0.07);
    color: var(--flame-300);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-status span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--flame-400);
    box-shadow: 0 0 0 4px rgba(240, 122, 24, 0.1);
  }

  .footer-navigation {
    display: grid;
    grid-template-columns: repeat(3, minmax(130px, 1fr));
    gap: clamp(28px, 5vw, 64px);
  }

  .footer-group h2 {
    margin-bottom: 17px;
    color: var(--carbon-100);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .footer-group ul {
    list-style: none;
  }

  .footer-group li + li {
    margin-top: 10px;
  }

  .footer-group a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--carbon-300);
    font-size: 14px;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-group a:hover {
    color: var(--flame-300);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    width: min(1120px, 100%);
    margin: 56px auto 0;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-bottom p {
    max-width: 700px;
    color: var(--carbon-400);
    font-size: 12px;
    line-height: 1.65;
  }

  .footer-bottom p:first-child {
    flex: 0 0 auto;
  }

  .analytics-choice {
    align-self: flex-start;
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    color: var(--carbon-300);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .analytics-choice:hover { color: var(--flame-300); }

  @media (max-width: 820px) {
    .footer {
      padding-top: 56px;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer-brand {
      max-width: 520px;
    }
  }

  @media (max-width: 560px) {
    .footer-navigation {
      grid-template-columns: 1fr 1fr;
      row-gap: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 10px;
      margin-top: 44px;
    }
  }

  @media (max-width: 380px) {
    .footer-navigation {
      grid-template-columns: 1fr;
    }
  }
</style>
