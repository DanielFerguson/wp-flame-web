---
interface Props {
  headline?: string;
  primary?: string;
  primaryHref?: string;
  secondary?: string;
  secondaryHref?: string;
}
const {
  headline = 'Have a dynamic WordPress workflow worth investigating?',
  primary = 'Apply with a real incident',
  primaryHref = '/design-partner/',
  secondary = 'Read the measurement limits',
  secondaryHref = '/compatibility/',
} = Astro.props;
---

<div class="post-demo-cta reveal">
  <p>{headline}</p>
  <div>
    <a href={primaryHref} class="btn-primary">{primary}</a>
    <a href={secondaryHref} class="btn-secondary">{secondary}</a>
  </div>
</div>

<style>
  .post-demo-cta { max-width: 900px; margin: 34px auto 0; display: flex; align-items: center; justify-content: space-between; gap: 26px; padding: 24px 28px; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.025); }
  .post-demo-cta p { color: white; font-size: 16px; font-weight: 600; }
  .post-demo-cta > div { display: flex; flex-wrap: wrap; gap: 10px; }
  .post-demo-cta :global(.btn-primary), .post-demo-cta :global(.btn-secondary) { padding: 10px 17px; font-size: 13px; }
  @media (max-width: 760px) { .post-demo-cta { align-items: flex-start; flex-direction: column; } }
</style>
