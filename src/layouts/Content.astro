---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { links } from '../config/links';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  noindex?: boolean;
  showActions?: boolean;
  showClosing?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  noindex = false,
  showActions = true,
  showClosing = true,
} = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <Nav cta="Join design partners" ctaHref={links.designPartner} />

  <header class="content-hero">
    <div class="content-wrap content-hero-inner">
      <div class="content-status" aria-label="Current release status">
        <span class="content-status-badge">Pre-release</span>
        <span>Paid design-partner programme</span>
      </div>
      <p class="content-eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="content-intro">{intro}</p>
      {showActions && (
        <div class="content-actions">
          <a class="btn-primary" href={links.designPartner}>Apply as a design partner</a>
          <a class="btn-secondary" href={links.sampleTrace}>Explore the sample trace</a>
        </div>
      )}
    </div>
  </header>

  <nav class="content-subnav" aria-label="Product information">
    <div class="content-wrap content-subnav-inner">
      <a href="/product/">Product</a>
      <a href="/docs/quickstart/">Quickstart</a>
      <a href="/community-vs-pro/">Community vs Pro</a>
      <a href="/benchmarks/">Benchmarks</a>
      <a href="/compatibility/">Compatibility</a>
      <a href="/support/">Support</a>
    </div>
  </nav>

  <main id="main-content" class="content-main">
    <slot />
  </main>

  {showClosing && (
    <section class="content-closing" aria-labelledby="content-closing-title">
      <div class="content-wrap content-closing-inner">
        <div>
          <p class="content-eyebrow">Current route to release</p>
          <h2 id="content-closing-title">Bring a real slow WordPress workflow.</h2>
          <p>
            The paid design-partner programme pairs controlled captures with founder-led review while
            the public release gates are completed.
          </p>
        </div>
        <a class="btn-primary" href={links.designPartner}>See the programme</a>
      </div>
    </section>
  )}

  <Footer />
</Base>

<style is:global>
  .content-wrap {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .content-hero {
    padding: 156px 0 76px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background:
      radial-gradient(circle at 20% 0%, rgba(240, 122, 24, 0.12), transparent 38%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent);
  }

  .content-hero-inner {
    max-width: 900px;
  }

  .content-status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
    color: var(--carbon-200);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  .content-status-badge,
  .content-tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 150, 50, 0.28);
    border-radius: 999px;
    background: rgba(240, 122, 24, 0.1);
    color: var(--flame-300);
    padding: 5px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .content-eyebrow {
    margin-bottom: 14px;
    color: var(--flame-400);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .content-hero h1 {
    max-width: 820px;
    margin-bottom: 24px;
    color: white;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }

  .content-intro {
    max-width: 760px;
    color: var(--carbon-200);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.65;
  }

  .content-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .content-subnav {
    position: sticky;
    top: 61px;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(14, 13, 18, 0.94);
    backdrop-filter: blur(16px);
  }

  .content-subnav-inner {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    padding-block: 14px;
    scrollbar-width: thin;
  }

  .content-subnav a {
    flex: 0 0 auto;
    color: var(--carbon-200);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .content-subnav a:hover,
  .content-subnav a:focus-visible,
  .content-main a:hover,
  .content-main a:focus-visible {
    color: var(--flame-300);
  }

  .content-main {
    min-height: 40vh;
    padding: 88px 0 112px;
  }

  .content-section {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
    margin-bottom: 96px;
  }

  .content-section:last-child {
    margin-bottom: 0;
  }

  .content-section--narrow {
    max-width: 800px;
  }

  .content-section-header {
    max-width: 760px;
    margin-bottom: 36px;
  }

  .content-section h2,
  .content-closing h2 {
    margin-bottom: 16px;
    color: white;
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .content-section h3 {
    margin-bottom: 10px;
    color: white;
    font-size: 20px;
    line-height: 1.3;
  }

  .content-card h2 {
    font-size: clamp(24px, 3vw, 32px);
  }

  .content-section h4 {
    margin-bottom: 8px;
    color: var(--carbon-100);
    font-size: 16px;
  }

  .content-section p,
  .content-section li,
  .content-closing p {
    color: var(--carbon-200);
    font-size: 16px;
    line-height: 1.75;
  }

  .content-section p + p {
    margin-top: 16px;
  }

  .content-section a {
    color: var(--flame-400);
    text-underline-offset: 3px;
  }

  .content-grid {
    display: grid;
    gap: 20px;
  }

  .content-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .content-card,
  .content-callout,
  .content-status-panel {
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
    padding: 28px;
  }

  .content-card--accent {
    border-color: rgba(240, 122, 24, 0.2);
    background: linear-gradient(150deg, rgba(240, 122, 24, 0.075), rgba(255, 255, 255, 0.018));
  }

  .content-card--purple {
    border-color: rgba(123, 92, 255, 0.2);
    background: linear-gradient(150deg, rgba(123, 92, 255, 0.075), rgba(255, 255, 255, 0.018));
  }

  .content-card ul,
  .content-checklist,
  .content-prose-list {
    margin-top: 16px;
    padding-left: 20px;
  }

  .content-card li + li,
  .content-checklist li + li,
  .content-prose-list li + li {
    margin-top: 8px;
  }

  .content-status-panel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    border-color: rgba(255, 150, 50, 0.2);
    background: rgba(240, 122, 24, 0.055);
  }

  .content-status-panel strong {
    display: block;
    margin-bottom: 5px;
    color: white;
  }

  .content-status-dot {
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--flame-400);
    box-shadow: 0 0 0 6px rgba(240, 122, 24, 0.12);
  }

  .content-callout {
    border-color: rgba(52, 212, 152, 0.2);
    background: rgba(52, 212, 152, 0.045);
  }

  .content-callout strong {
    color: var(--insight-300);
  }

  .content-kicker {
    margin-bottom: 10px;
    color: var(--flame-300) !important;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px !important;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .content-steps {
    list-style: none;
    counter-reset: content-step;
    padding: 0;
  }

  .content-steps li {
    counter-increment: content-step;
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .content-steps li::before {
    content: counter(content-step, decimal-leading-zero);
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(240, 122, 24, 0.11);
    color: var(--flame-300);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
  }

  .content-steps strong {
    display: block;
    margin-bottom: 4px;
    color: white;
  }

  .content-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 14px;
  }

  .content-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.02);
    text-align: left;
  }

  .content-table caption {
    padding: 16px 18px;
    color: var(--carbon-200);
    font-weight: 600;
    text-align: left;
  }

  .content-table th,
  .content-table td {
    padding: 16px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--carbon-200);
    font-size: 14px;
    line-height: 1.55;
    vertical-align: top;
  }

  .content-table th {
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .content-table tr:last-child td {
    border-bottom: 0;
  }

  .content-definition {
    display: grid;
    grid-template-columns: minmax(160px, 0.35fr) 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .content-definition dt {
    color: white;
    font-weight: 700;
  }

  .content-definition dd {
    color: var(--carbon-200);
    line-height: 1.7;
  }

  .content-link-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .content-link-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 16px 18px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--carbon-100);
    font-weight: 600;
    text-decoration: none;
  }

  .content-link-list a::after {
    content: '→';
    color: var(--flame-400);
  }

  .content-closing {
    padding: 72px 0;
    border-block: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--carbon-800);
  }

  .content-closing-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .content-closing-inner > div {
    max-width: 700px;
  }

  @media (max-width: 800px) {
    .content-wrap,
    .content-section {
      width: min(100% - 32px, 1120px);
    }

    .content-hero {
      padding-top: 128px;
    }

    .content-grid--2,
    .content-grid--3,
    .content-link-list {
      grid-template-columns: 1fr;
    }

    .content-status-panel,
    .content-definition {
      grid-template-columns: 1fr;
    }

    .content-closing-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .content-hero h1 {
      font-size: 36px;
    }

    .content-actions > a,
    .content-closing .btn-primary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .content-card,
    .content-callout,
    .content-status-panel {
      padding: 22px;
    }

    .content-steps li {
      grid-template-columns: 1fr;
    }
  }
</style>
