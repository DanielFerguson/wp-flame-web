---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  campaign: string;      // utm_campaign value
  audience: string;      // woocommerce | agency | pagebuilder
  source: string;        // google | facebook
  noindex?: boolean;
}

const { title, description, campaign, audience, source, noindex = true } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div data-campaign={campaign} data-audience={audience} data-source={source}>
    <Nav cta={source === 'google' ? 'Install free' : 'Learn more'} />
    <slot />
    <Footer />
  </div>

  <style is:global>
    /* Campaign pages: tighter, more conversion-focused */
    .campaign-hero {
      min-height: 90vh; display: flex; flex-direction: column;
      justify-content: center; align-items: center; text-align: center;
      padding: 120px 40px 80px; position: relative;
    }
    .campaign-hero::before {
      content: ''; position: absolute; top: -200px; left: 50%; transform: translateX(-50%);
      width: 1000px; height: 1000px;
      background: radial-gradient(ellipse at center, rgba(240,122,24,0.08) 0%, rgba(232,77,48,0.04) 30%, transparent 60%);
      pointer-events: none;
    }
    .campaign-hero h1 {
      font-size: clamp(36px, 5.5vw, 64px); font-weight: 700; color: white;
      letter-spacing: -0.035em; line-height: 1.1; max-width: 780px;
      margin-bottom: 24px; animation: fadeInUp 0.9s ease-out 0.1s both;
    }
    .campaign-hero h1 em {
      font-family: 'Instrument Serif', serif; font-style: italic;
      color: var(--flame-400); font-weight: 400;
    }
    .campaign-hero .hero-sub {
      font-size: clamp(17px, 2vw, 20px); color: var(--carbon-300);
      max-width: 540px; margin-bottom: 40px; line-height: 1.6;
      animation: fadeInUp 0.9s ease-out 0.2s both;
    }
    .campaign-hero .hero-actions {
      display: flex; gap: 16px; align-items: center; flex-wrap: wrap;
      justify-content: center; animation: fadeInUp 0.9s ease-out 0.3s both;
    }
    .campaign-hero .hero-proof {
      margin-top: 40px; display: flex; gap: 32px; flex-wrap: wrap; justify-content: center;
      font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--carbon-400);
      animation: fadeInUp 0.9s ease-out 0.4s both;
    }

    /* Hero pricing pill */
    .campaign-hero .hero-pill {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(240,122,24,0.08); border: 1px solid rgba(240,122,24,0.15);
      border-radius: 100px; padding: 7px 20px 7px 14px;
      font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 500;
      color: var(--flame-400); margin-bottom: 32px; animation: fadeIn 0.8s ease-out;
    }
    .campaign-hero .hero-pill .dot {
      width: 6px; height: 6px; border-radius: 50%; background: var(--flame-400); animation: pulse 2s infinite;
    }

    /* Mid-page CTA */
    .mid-cta {
      text-align: center; padding: 48px 40px; max-width: 640px; margin: 0 auto;
    }
    .mid-cta p {
      font-size: clamp(18px, 2.2vw, 22px); font-weight: 600; color: white;
      margin-bottom: 24px; letter-spacing: -0.01em;
    }
    .mid-cta .mid-cta-actions {
      display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap;
    }

    /* Pain points grid */
    .pain-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px; margin-top: 48px;
    }
    .pain-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px; padding: 28px; transition: border-color 0.3s;
    }
    .pain-card:hover { border-color: rgba(240,122,24,0.2); }
    .pain-card h3 { font-size: 16px; font-weight: 600; color: white; margin-bottom: 8px; }
    .pain-card p { font-size: 14px; color: var(--carbon-300); line-height: 1.6; }
    .pain-number {
      font-family: 'JetBrains Mono', monospace; font-size: 36px; font-weight: 700;
      color: var(--flame-400); margin-bottom: 12px; letter-spacing: -0.03em;
    }

    /* Campaign CTA section */
    .campaign-cta {
      text-align: center; padding: 120px 0; position: relative;
    }
    .campaign-cta h2 {
      font-size: clamp(32px, 4.5vw, 52px); font-weight: 700; color: white;
      letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 20px;
    }
    .campaign-cta h2 em {
      font-family: 'Instrument Serif', serif; font-style: italic;
      color: var(--flame-400); font-weight: 400;
    }
    .campaign-cta p {
      font-size: 18px; color: var(--carbon-300); max-width: 480px;
      margin: 0 auto 40px;
    }
    .campaign-cta .hero-actions { justify-content: center; }

    @media (max-width: 900px) {
      .campaign-hero { padding: 100px 20px 60px; }
      .campaign-hero .hero-proof { flex-direction: column; gap: 8px; }
    }
  </style>
</Base>
