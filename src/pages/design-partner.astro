---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DesignPartnerForm from '../components/DesignPartnerForm.astro';
import '../styles/global.css';

const title = 'WP Flame Design-Partner Programme';
const description = 'Bring a real slow WordPress workflow to a founder-led diagnosis programme and help shape WP Flame’s public release.';
---

<Base title={title} description={description}>
  <Nav cta="Apply now" ctaHref="#application" />
  <main id="main-content">
    <section class="programme-hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">Paid design-partner programme</div>
          <h1>Bring us the WordPress workflow that is slowing you down.</h1>
          <p class="hero-copy">
            Capture a real dynamic request, review the largest supported measured
            contributors with the founder, and verify whether the next change improved it.
          </p>
          <div class="hero-actions">
            <a class="btn-primary" href="#application" data-analytics-event="design_partner_application_cta_clicked" data-analytics-placement="programme_hero">Apply with a real incident</a>
            <a class="btn-secondary" href="/sample-trace/" data-analytics-event="sample_trace_cta_clicked" data-analytics-placement="programme_hero">Explore a sample trace</a>
          </div>
        </div>

        <aside class="offer-card" aria-label="Founding programme offer">
          <div class="offer-kicker">Founding offer being tested</div>
          <div class="offer-price"><strong>$99</strong><span>/ year</span></div>
          <p>Up to five authorised production sites, with staging and local environments excluded from the site count.</p>
          <ul>
            <li>Direct founder onboarding</li>
            <li>One defined slow workflow to start</li>
            <li>Regular diagnosis and feedback review</li>
            <li>Advance notice before any renewal-tier change</li>
          </ul>
          <p class="offer-note">No lifetime entitlement. Currency, tax, payment, cancellation, renewal, and refund terms are confirmed in writing before payment. Final public packaging remains subject to validation.</p>
        </aside>
      </div>
    </section>

    <section class="section compact-section">
      <div class="container">
        <div class="section-heading">
          <div class="label">Who it is for</div>
          <h2 class="sec-title">A real incident, a technical owner, and a next action.</h2>
          <p class="sec-desc">
            This is deliberately narrower than an open beta. The programme works best when
            there is a dynamic request that still executes WordPress and someone able to act
            on or delegate the diagnosis.
          </p>
        </div>
        <div class="fit-grid">
          <article class="fit-card good-fit">
            <h3>Strong fit</h3>
            <ul>
              <li>Agencies or freelancers managing dynamic client sites</li>
              <li>Slow checkout, admin, editor, REST, AJAX, cron, or logged-in work</li>
              <li>A suspected regression after a plugin, theme, core, or configuration change</li>
              <li>Evidence needed for a developer, host, client, or plugin vendor</li>
            </ul>
          </article>
          <article class="fit-card poor-fit">
            <h3>Probably not a fit yet</h3>
            <ul>
              <li>A brochure site seeking a one-click PageSpeed score increase</li>
              <li>A request served entirely from a page cache or CDN</li>
              <li>An expectation that WP Flame will change settings or repair the site automatically</li>
              <li>No technical owner available to act on the evidence</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading">
          <div class="label">How the programme works</div>
          <h2 class="sec-title">Evidence first, with explicit boundaries.</h2>
        </div>
        <ol class="process-list">
          <li><span>01</span><div><h3>Qualify the workflow</h3><p>We confirm that the incident is eligible, dynamic, reproducible, and commercially meaningful.</p></div></li>
          <li><span>02</span><div><h3>Authorise the site</h3><p>Every customer or production site requires separate written authorisation before installation or trace review.</p></div></li>
          <li><span>03</span><div><h3>Capture within bounds</h3><p>We choose an appropriate capture mode and record what the trace could and could not observe.</p></div></li>
          <li><span>04</span><div><h3>Review the evidence</h3><p>We inspect the largest measured contributors, confidence, supporting samples, and the safest next action.</p></div></li>
          <li><span>05</span><div><h3>Verify the change</h3><p>Where the workflow permits, we repeat compatible captures and compare the evidence before and after.</p></div></li>
        </ol>
        <div class="consent-note">
          Programme participation does not grant permission to publish trace data, research notes,
          a testimonial, or a case study. Each use requires separate, specific consent.
        </div>
      </div>
    </section>

    <section class="section" id="application">
      <div class="container">
        <DesignPartnerForm />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .programme-hero {
    padding: 170px 0 100px;
    position: relative;
    overflow: hidden;
  }

  .programme-hero::before {
    content: '';
    position: absolute;
    inset: -300px auto auto 45%;
    width: 900px;
    height: 900px;
    background: radial-gradient(circle, rgba(240, 122, 24, 0.11), transparent 62%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.65fr);
    gap: clamp(48px, 8vw, 96px);
    align-items: center;
    position: relative;
  }

  .eyebrow,
  .offer-kicker {
    color: var(--flame-300);
    font: 600 11px/1.4 'JetBrains Mono', monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  h1 {
    color: white;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 820px;
  }

  .hero-copy {
    color: var(--carbon-200);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.65;
    max-width: 720px;
    margin: 28px 0 36px;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }

  .offer-card {
    padding: 34px;
    border: 1px solid rgba(255, 150, 50, 0.22);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(240, 122, 24, 0.08), rgba(255, 255, 255, 0.025));
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
  }

  .offer-price { display: flex; align-items: baseline; gap: 7px; margin-bottom: 16px; }
  .offer-price strong { color: white; font-size: 52px; line-height: 1; }
  .offer-price span, .offer-card p { color: var(--carbon-300); }
  .offer-card ul { list-style: none; margin: 24px 0; }
  .offer-card li { color: var(--carbon-100); padding: 8px 0 8px 24px; position: relative; }
  .offer-card li::before { content: '✓'; position: absolute; left: 0; color: #7ce8bd; }
  .offer-card .offer-note { font-size: 12px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 18px; }

  .compact-section { padding-top: 90px; }
  .section-heading { max-width: 760px; margin-bottom: 48px; }
  .fit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .fit-card { border-radius: 16px; padding: 32px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); }
  .fit-card h3 { color: white; font-size: 20px; margin-bottom: 18px; }
  .fit-card ul { padding-left: 20px; }
  .fit-card li { color: var(--carbon-200); margin: 12px 0; }
  .good-fit { border-color: rgba(52, 212, 152, .2); }
  .poor-fit { border-color: rgba(255, 153, 128, .18); }

  .process-section { background: var(--carbon-800); border-block: 1px solid rgba(255,255,255,.05); }
  .process-list { list-style: none; max-width: 920px; }
  .process-list li { display: grid; grid-template-columns: 54px 1fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
  .process-list li > span { color: var(--flame-300); font: 600 12px 'JetBrains Mono', monospace; }
  .process-list h3 { color: white; margin-bottom: 7px; }
  .process-list p { color: var(--carbon-300); }
  .consent-note { max-width: 920px; margin-top: 32px; padding: 20px 24px; border-left: 3px solid var(--flame-400); background: rgba(240,122,24,.055); color: var(--carbon-200); }

  @media (max-width: 850px) {
    .hero-grid, .fit-grid { grid-template-columns: 1fr; }
    .programme-hero { padding-top: 130px; }
  }
</style>
