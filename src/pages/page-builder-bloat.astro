---
import Campaign from "../layouts/Campaign.astro";
import FlameDemo from "../components/FlameDemo.astro";
import AiInsight from "../components/AiInsight.astro";
import PostDemoCta from "../components/PostDemoCta.astro";
import TrustBar from "../components/TrustBar.astro";
import Faq from "../components/Faq.astro";
import Pricing from "../components/Pricing.astro";
import { links } from "../config/links";
---

<Campaign
  title="Your Page Builder Is Adding 500ms to Every Page Load — WP Flame"
  description="See exactly what Elementor, Divi, or Beaver Builder is doing during your page load. Free flame graph APM for WordPress."
  campaign="pagebuilder-facebook"
  audience="pagebuilder"
  source="facebook"
>
  <section class="campaign-hero">
    <div class="hero-pill"><span class="dot"></span> Free APM — AI insights from $29/mo</div>
    <h1>Your page builder is loading 847KB of JSON on <em>every</em> page.</h1>
    <p class="hero-sub">
      That's not a guess. That's what WP Flame found on a real Elementor site.
      Want to see what it finds on yours?
    </p>
    <div class="hero-actions">
      <a href="#demo" class="btn-primary btn-large">See the breakdown ↓</a>
      <a href="#download" class="btn-primary btn-large">Install free</a>
    </div>
    <div class="hero-proof">
      <span>Elementor, Divi, Beaver Builder, WPBakery</span>
      <span>Under 5ms overhead</span>
      <span>Free forever</span>
    </div>
  </section>

  <section style="padding:0 40px 60px;">
    <TrustBar />
  </section>

  <!-- Shocking stat section -->
  <section class="section">
    <div class="container">
      <div class="bloat-reveal reveal">
        <div class="bloat-item">
          <div class="bloat-visual">
            <div
              class="bloat-bar"
              style="height:100%;background:linear-gradient(to top,var(--ember-500),var(--flame-400));"
            >
              <span>847 KB</span>
            </div>
          </div>
          <div class="bloat-label">JSON metadata loaded per page</div>
        </div>
        <div class="bloat-item">
          <div class="bloat-visual">
            <div
              class="bloat-bar"
              style="height:65%;background:linear-gradient(to top,var(--ember-400),var(--flame-300));"
            >
              <span>30</span>
            </div>
          </div>
          <div class="bloat-label">CSS + JS files enqueued</div>
        </div>
        <div class="bloat-item">
          <div class="bloat-visual">
            <div
              class="bloat-bar"
              style="height:80%;background:linear-gradient(to top,var(--ember-500),var(--flame-400));"
            >
              <span>540ms</span>
            </div>
          </div>
          <div class="bloat-label">Of your load time is the page builder</div>
        </div>
        <div class="bloat-item">
          <div class="bloat-visual">
            <div
              class="bloat-bar"
              style="height:45%;background:linear-gradient(to top,var(--ai-500),var(--ai-400));"
            >
              <span>~50%</span>
            </div>
          </div>
          <div class="bloat-label">Reducible with the right settings</div>
        </div>
      </div>
      <p
        style="text-align:center;margin-top:24px;font-size:14px;color:var(--carbon-400);"
      >
        Real numbers from an Elementor site. Divi and WPBakery are similar.
      </p>
    </div>
  </section>

  <!-- Demo -->
  <section style="padding:0 40px 100px;" id="demo">
    <FlameDemo variant="elementor" showAi={true}>
      <Fragment slot="insights">
        <AiInsight
          severity="high"
          title="847KB JSON blob is loaded and parsed on every page view"
          body="Elementor stores your entire page layout as JSON in <code>_elementor_data</code>. It deserialises this on every request, even if the output CSS is already cached."
          action="Switch CSS Print Method to 'External File' — Elementor will serve pre-compiled CSS instead of parsing JSON"
        />
        <AiInsight
          severity="medium"
          title="18 CSS files loaded — most contain unused rules"
          body="Elementor loads widget CSS for widgets not present on this page. Only 4 of 18 stylesheets contain rules that match elements on the page."
          action="Enable Improved Asset Loading in Elementor Experiments to load only needed widget CSS"
        />
      </Fragment>
    </FlameDemo>
  </section>

  <PostDemoCta headline="Find out what your page builder is really doing." />

  <!-- Simple CTA -->
  <section class="section bg-raised">
    <div class="container">
      <div
        style="text-align:center;max-width:600px;margin:0 auto;"
        class="reveal"
      >
        <h2 class="sec-title">You don't have to ditch your page builder.</h2>
        <p class="sec-desc" style="text-align:center;">
          Most of the performance overhead is fixable. Wrong settings, unused
          features, redundant asset loading. WP Flame shows you exactly what to
          change — and the free version gives you all the data you need.
        </p>
        <p class="sec-desc" style="text-align:center;">
          Want AI to read the flame graph for you and tell you exactly what to
          do? That's the $29/month plan.
        </p>
        <div
          style="display:flex;gap:16px;justify-content:center;margin-top:32px;"
        >
          <a href={links.wordpressOrg} class="btn-primary">Install free</a>
          <a href={links.sparkTrial} class="btn-ai">✨ Try AI insights</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="container">
      <div style="text-align:center;margin-bottom:72px;" class="reveal">
        <div class="label">Pricing</div>
        <h2 class="sec-title">Free APM. Paid <em>intelligence.</em></h2>
      </div>
      <Pricing highlight="spark" />
    </div>
  </section>

  <section class="section">
    <Faq audience="pagebuilder" />
  </section>

  <!-- Final CTA -->
  <section class="campaign-cta" id="download">
    <div class="container reveal">
      <h2>See what your page builder is <em>really</em> doing.</h2>
      <p>One install. One page load. The full picture.</p>
      <div class="hero-actions">
        <a href={links.wordpressOrg} class="btn-primary btn-large">Install free ↓</a>
        <a href={links.sparkTrial} class="btn-ai btn-large">✨ Try AI insights</a>
      </div>
    </div>
  </section>
</Campaign>

<style>
  .bloat-reveal {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .bloat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .bloat-visual {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
    padding: 8px;
    margin-bottom: 12px;
  }
  .bloat-bar {
    width: 60%;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 20px;
    transition: height 1s ease-out;
  }
  .bloat-bar span {
    font-family: "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: 700;
    color: white;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }
  .bloat-label {
    font-size: 13px;
    color: var(--carbon-300);
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .bloat-reveal {
      grid-template-columns: repeat(2, 1fr);
    }
    .bloat-visual {
      height: 140px;
    }
  }
</style>
