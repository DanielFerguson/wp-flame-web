---
import Campaign from "../layouts/Campaign.astro";
import FlameDemo from "../components/FlameDemo.astro";
import AiInsight from "../components/AiInsight.astro";
import Pricing from "../components/Pricing.astro";
import PostDemoCta from "../components/PostDemoCta.astro";
import TrustBar from "../components/TrustBar.astro";
import Faq from "../components/Faq.astro";
import CompareTable from "../components/CompareTable.astro";
import { links } from "../config/links";
---

<Campaign
  title="Why Is Elementor Slow? See Exactly Where the Time Goes — WP Flame"
  description="Free flame graph shows exactly what Elementor is doing during your page load: JSON parsing, CSS compilation, widget rendering. AI tells you what to fix."
  campaign="elementor-google"
  audience="pagebuilder"
  source="google"
  noindex={false}
>
  <section class="campaign-hero">
    <div class="hero-pill"><span class="dot"></span> Free APM — AI insights from $29/mo</div>
    <h1>
      Why is Elementor <em>slow?</em><br />Here's exactly what it's doing.
    </h1>
    <p class="hero-sub">
      WP Flame shows you a visual timeline of every Elementor operation during
      page load — JSON parsing, CSS compilation, widget rendering, script
      enqueuing. Then AI tells you what to fix.
    </p>
    <div class="hero-actions">
      <a href="#download" class="btn-primary btn-large"
        >Install free — see the flame graph ↓</a
      >
      <a href="#pricing" class="btn-ai btn-large">✨ See AI insights</a>
    </div>
    <div class="hero-proof">
      <span>Works with Elementor, Divi, Beaver Builder, WPBakery</span>
    </div>
  </section>

  <section style="padding:0 40px 60px;">
    <TrustBar />
  </section>

  <section style="padding:0 40px 100px;">
    <FlameDemo variant="elementor" showAi={true}>
      <Fragment slot="insights">
        <AiInsight
          severity="high"
          title="Elementor is loading 847KB of JSON metadata on every page load"
          body="The <code>_elementor_data</code> postmeta field is loaded and deserialized during <code>the_content()</code>, adding 55ms of PHP processing and 4.2MB of memory."
          action="Switch Elementor CSS Print Method to 'External File' in Elementor → Settings → Advanced"
        />
        <AiInsight
          severity="high"
          title="12 widget renders are taking 180ms combined"
          body="Each Elementor widget runs its own render method with individual DB queries and filter callbacks. The heading widget alone takes 22ms due to dynamic tag resolution."
          action="Replace dynamic content widgets with static text where possible — dynamic tags add overhead per widget"
        />
        <AiInsight
          severity="medium"
          title="18 CSS files and 12 JS files are enqueued"
          body="Elementor is loading 30 separate assets. Each adds a blocking request. The combined CSS is 340KB before GZIP."
          action="Enable Elementor's Improved Asset Loading (Experiments → Improved Asset Loading) to load only what each page needs"
        />
      </Fragment>
    </FlameDemo>
  </section>

  <PostDemoCta headline="Find out what Elementor is doing on your site." />

  <!-- Elementor-specific breakdown -->
  <section class="section bg-raised">
    <div class="container">
      <div style="text-align:center;margin-bottom:64px;" class="reveal">
        <div class="label">What WP Flame typically finds</div>
        <h2 class="sec-title">
          The anatomy of an <em>Elementor</em> page load
        </h2>
      </div>
      <div class="timeline-breakdown reveal">
        <div class="tb-item">
          <div class="tb-bar" style="width:11%;background:var(--ai-400);">
          </div><div class="tb-label">
            Widget registration <span>110ms</span>
          </div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:5%;background:var(--flame-400);">
          </div><div class="tb-label">CSS compile check <span>45ms</span></div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:6%;background:var(--ember-400);">
          </div><div class="tb-label">
            _elementor_data JSON load <span>55ms</span>
          </div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:19%;background:var(--ember-500);">
          </div><div class="tb-label">
            Widget rendering (×12) <span>180ms</span>
          </div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:6%;background:var(--flame-400);">
          </div><div class="tb-label">
            Dynamic CSS generation <span>60ms</span>
          </div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:9%;background:var(--flame-300);">
          </div><div class="tb-label">
            Asset enqueuing (30 files) <span>90ms</span>
          </div>
        </div>
        <div class="tb-item">
          <div class="tb-bar" style="width:44%;background:var(--carbon-600);">
          </div><div class="tb-label">Everything else <span>422ms</span></div>
        </div>
      </div>
      <p
        style="text-align:center;margin-top:32px;font-size:14px;color:var(--carbon-400);"
        class="reveal"
      >
        Real data from an Elementor-built landing page. 962ms total load time,
        540ms attributable to Elementor.
      </p>
    </div>
  </section>

  <div class="mid-cta">
    <p>See your Elementor breakdown.</p>
    <div class="mid-cta-actions">
      <a href="#download" class="btn-primary">Install free</a>
      <a href="#pricing" class="btn-ai">✨ Try AI</a>
    </div>
  </div>

  <CompareTable />

  <!-- Pricing -->
  <section class="section" id="pricing">
    <div class="container">
      <div style="text-align:center;margin-bottom:72px;" class="reveal">
        <div class="label">Pricing</div>
        <h2 class="sec-title">Free APM. Paid <em>intelligence.</em></h2>
      </div>
      <Pricing highlight="spark" />
    </div>
  </section>

  <section class="section">
    <Faq audience="pagebuilder" />
  </section>

  <!-- Final CTA -->
  <section class="campaign-cta" id="download">
    <div class="container reveal">
      <h2>Elementor doesn't have to be <em>slow.</em></h2>
      <p>
        Most of the overhead is fixable with the right settings changes. WP
        Flame shows you exactly which ones.
      </p>
      <div class="hero-actions">
        <a href={links.wordpressOrg} class="btn-primary btn-large">Install free ↓</a>
        <a href={links.sparkTrial} class="btn-ai btn-large">✨ Try AI insights free</a>
      </div>
    </div>
  </section>
</Campaign>

<style>
  .timeline-breakdown {
    max-width: 700px;
    margin: 0 auto;
  }
  .tb-item {
    margin-bottom: 12px;
  }
  .tb-bar {
    height: 28px;
    border-radius: 4px;
    min-width: 4px;
  }
  .tb-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--carbon-200);
    margin-top: 4px;
  }
  .tb-label span {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--carbon-400);
  }
</style>
