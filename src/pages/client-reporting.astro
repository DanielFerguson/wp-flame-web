---
import Campaign from "../layouts/Campaign.astro";
import FlameDemo from "../components/FlameDemo.astro";
import AiInsight from "../components/AiInsight.astro";
import PostDemoCta from "../components/PostDemoCta.astro";
import TrustBar from "../components/TrustBar.astro";
import Faq from "../components/Faq.astro";
import Pricing from "../components/Pricing.astro";
import { links } from "../config/links";
---

<Campaign
  title="Show Clients Exactly Why Their WordPress Site Is Slow — WP Flame"
  description="Turn WordPress performance into a visual story your clients understand. Free flame graphs with AI recommendations for agencies."
  campaign="agency-facebook"
  audience="agency"
  source="facebook"
>
  <section class="campaign-hero">
    <div class="hero-pill"><span class="dot"></span> Free APM — Agency plan from $199/mo</div>
    <h1>Your client's site is slow. Can you show them <em>exactly</em> why?</h1>
    <p class="hero-sub">
      One plugin turns "your site needs performance work" into a visual flame
      graph that sells the project for you.
    </p>
    <div class="hero-actions">
      <a href="#demo" class="btn-primary btn-large"
        >See what your clients will see ↓</a
      >
      <a href="#download" class="btn-primary btn-large">Install free</a>
    </div>
    <div class="hero-proof">
      <span>Free core forever</span>
      <span>Zero config</span>
      <span>Self-hosted data</span>
    </div>
  </section>

  <section style="padding:0 40px 60px;">
    <TrustBar />
  </section>

  <!-- The agency story -->
  <section class="section">
    <div class="container">
      <div class="story-grid reveal">
        <div class="story-card before">
          <div class="story-label">Before WP Flame</div>
          <h3>"We think your site needs some performance optimisation"</h3>
          <ul>
            <li>Vague proposals that clients can't evaluate</li>
            <li>"Trust us, it'll be faster" with no proof</li>
            <li>Performance retainer feels like a black box</li>
            <li>Clients question the value after the invoice</li>
          </ul>
        </div>
        <div class="story-card after">
          <div class="story-label">After WP Flame</div>
          <h3>
            "Here's a flame graph. These 3 plugins add 400ms. Here's the fix."
          </h3>
          <ul>
            <li>Visual proof that clients instantly understand</li>
            <li>Specific, named issues with time impact</li>
            <li>AI-generated fix recommendations in the report</li>
            <li>Before/after traces that prove the improvement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="mid-cta">
    <p>Try it on a client site — free.</p>
    <div class="mid-cta-actions">
      <a href="#download" class="btn-primary">Install free</a>
      <a href="#pricing" class="btn-ai">See Agency plan</a>
    </div>
  </div>

  <!-- Demo -->
  <section style="padding:0 40px 100px;" id="demo">
    <FlameDemo variant="agency" showAi={true}>
      <Fragment slot="insights">
        <AiInsight
          severity="high"
          title="3 plugins are making blocking license checks (90ms)"
          body="WooCommerce, Elementor Pro, and WPML each verify their license on every page load. This is dead time — no rendering, no content."
          action="Switch all three to scheduled wp-cron verification instead of per-request checks"
        />
        <AiInsight
          severity="high"
          title="ACF is running 60 individual meta queries (120ms)"
          body="Each custom field is loaded with a separate DB call during template render. Batch loading would reduce this to a single query."
          action="Use get_fields() or enable ACF Local JSON to eliminate runtime DB reads"
        />
      </Fragment>
    </FlameDemo>
  </section>

  <PostDemoCta headline="Turn this into a client report in one click." />

  <section class="section" id="pricing">
    <div class="container">
      <div style="text-align:center;margin-bottom:72px;" class="reveal">
        <div class="label">Pricing</div>
        <h2 class="sec-title">Free APM. Agency-grade <em>intelligence.</em></h2>
      </div>
      <Pricing highlight="agency" />
    </div>
  </section>

  <section class="section">
    <Faq audience="agency" />
  </section>

  <!-- CTA -->
  <section class="campaign-cta" id="download">
    <div class="container reveal">
      <h2>Performance work that <em>sells itself.</em></h2>
      <p>
        Install WP Flame on a client site. The flame graph is the pitch deck.
      </p>
      <div class="hero-actions">
        <a href={links.wordpressOrg} class="btn-primary btn-large">Install free</a>
        <a href={links.agencyTrial} class="btn-ai btn-large">✨ Try Agency plan</a>
      </div>
    </div>
  </section>
</Campaign>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .story-card {
    border-radius: 14px;
    padding: 36px 32px;
  }
  .story-card.before {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .story-card.after {
    background: linear-gradient(
      160deg,
      rgba(123, 92, 255, 0.06),
      rgba(99, 68, 224, 0.02)
    );
    border: 1px solid rgba(123, 92, 255, 0.15);
  }
  .story-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .before .story-label {
    color: var(--carbon-400);
  }
  .after .story-label {
    color: var(--ai-400);
  }
  .story-card h3 {
    font-size: 18px;
    font-weight: 600;
    color: white;
    margin-bottom: 20px;
    line-height: 1.4;
    font-style: italic;
  }
  .story-card ul {
    list-style: none;
  }
  .story-card li {
    padding: 8px 0;
    font-size: 14px;
    color: var(--carbon-300);
    line-height: 1.5;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .story-card li:last-child {
    border-bottom: none;
  }
  .before li::before {
    content: "✗";
    color: var(--ember-400);
    font-weight: 700;
    font-size: 12px;
    margin-top: 2px;
  }
  .after li::before {
    content: "✓";
    color: var(--ai-400);
    font-weight: 700;
    font-size: 12px;
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
