---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlameDemo from '../components/FlameDemo.astro';
import AiInsight from '../components/AiInsight.astro';
import Pricing from '../components/Pricing.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import FoundingMemberCta from '../components/FoundingMemberCta.astro';
import PostDemoCta from '../components/PostDemoCta.astro';
import Faq from '../components/Faq.astro';
import CompareTable from '../components/CompareTable.astro';
import '../styles/global.css';
import { links } from '../config/links';
---
<Base title="WP Flame — See exactly where your WordPress request spends its time" jsonLd={{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "WP Flame",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "WordPress",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}}>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-pill"><span class="dot"></span> Free APM — AI insights from $29/mo</div>
    <h1>See where your WordPress request spends its <em>time</em></h1>
    <p class="hero-sub">Free flame graphs show you the data. AI-powered insights tell you exactly what to fix, why it matters, and how to do it.</p>
    <div class="hero-actions">
      <a href="#download" class="btn-primary">Install free ↓</a>
      <a href="#demo" class="btn-secondary">See it in action</a>
    </div>
    <div class="hero-meta">
      <span>Free core forever</span>
      <span>Zero dependencies</span>
      <span>No PHP extensions</span>
      <span>Self-hosted</span>
    </div>
  </section>

  <!-- DEMO -->
  <section class="demo-section" id="demo">
    <FlameDemo variant="default" showAi={true}>
      <Fragment slot="insights">
        <AiInsight severity="high"
          title="WooCommerce is making a blocking HTTP call during init"
          body='The transient check at <code>plugins_loaded → WC transient check</code> adds 27ms on every page load to verify a license.'
          action="Add a version-gated check to skip the HTTP call when the transient hasn't expired" />
        <AiInsight severity="high"
          title="Elementor is loading 847KB of JSON metadata on every request"
          body='The <code>_elementor_data</code> postmeta field is being deserialized during <code>the_content()</code>. This accounts for 68ms.'
          action="Enable Elementor's CSS Print Method → External File to avoid runtime JSON parsing" />
        <AiInsight severity="medium"
          title="oEmbed HTTP call is not being cached"
          body='A YouTube oEmbed request at <code>the_content() → oEmbed HTTP</code> adds 45ms. The cache appears expired or missing.'
          action="Check if object caching is configured — oEmbed transients may be evicted prematurely" />
      </Fragment>
    </FlameDemo>
  </section>

  <PostDemoCta />

  <VideoEmbed />

  <CredibilityStrip />

  <!-- DATA + INSIGHTS SPLIT -->
  <section class="section" id="philosophy">
    <div class="container">
      <div class="features-header reveal">
        <div class="label">The model</div>
        <h2 class="sec-title">The data is free. The <em>intelligence</em> is not.</h2>
        <p style="font-size:17px;color:var(--carbon-300);max-width:560px;margin:0 auto;">Every WordPress site deserves visibility into its performance. AI analysis that turns data into action is where the value lives.</p>
      </div>
      <div class="two-halves reveal">
        <div class="half-card half-free">
          <div class="half-label">Free forever</div>
          <h3>See everything</h3>
          <p class="half-desc">The full APM. No feature gates, no trial period, no "upgrade to see your results."</p>
          <ul class="half-list"><li>Interactive flame graph visualisation</li><li>Per-plugin and per-callback timing</li><li>Database query tracking and attribution</li><li>External HTTP call monitoring</li><li>Trace history and browsing</li><li>Template and theme profiling</li><li>WP-CLI integration</li><li>Export traces as JSON</li></ul>
        </div>
        <div class="half-card half-ai">
          <div class="half-label">✦ AI insights — from $29/mo</div>
          <h3>Know what to fix</h3>
          <p class="half-desc">AI reads your traces and tells you exactly what's wrong, why it matters, and what to do about it.</p>
          <ul class="half-list"><li>Plain-English performance recommendations</li><li>Root cause analysis for slow spans</li><li>Plugin-specific remediation steps</li><li>Severity scoring and prioritisation</li><li>Regression detection across traces</li><li>Configuration advice (caching, DB, hosting)</li><li>Weekly performance digests</li><li>"Ask Flame" — chat with your trace data</li></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section" id="features">
    <div class="container">
      <div class="features-header reveal">
        <div class="label">Features</div>
        <h2 class="sec-title">Everything you need. Nothing gated.</h2>
        <p style="font-size:17px;color:var(--carbon-300);max-width:560px;margin:0 auto;">The full APM is free. AI features are marked with ✦.</p>
      </div>
      <div class="features-grid reveal">
        <div class="card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">Flame graphs <span class="feature-badge badge-free">Free</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">Every hook, callback, query, and HTTP call rendered as a zoomable, clickable timeline.</p></div>
        <div class="card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">Plugin attribution <span class="feature-badge badge-free">Free</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">Every span traced to its source plugin, theme, or core function.</p></div>
        <div class="card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">Query tracking <span class="feature-badge badge-free">Free</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">Every SQL query with its duration, caller, and source. Spot N+1 problems at a glance.</p></div>
        <div class="card ai-card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">AI recommendations <span class="feature-badge badge-ai">✦ AI</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">Plain-English explanations of what's slow, why it matters, and exactly what to change.</p></div>
        <div class="card ai-card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">Regression detection <span class="feature-badge badge-ai">✦ AI</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">Compares traces over time and alerts you when something makes things slower.</p></div>
        <div class="card ai-card"><h3 style="font-size:17px;font-weight:600;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px;">Ask Flame <span class="feature-badge badge-ai">✦ AI</span></h3><p style="font-size:14px;color:var(--carbon-300);line-height:1.6;">"Why is my shop page slow?" Chat directly with your trace data.</p></div>
      </div>
    </div>
  </section>

  <CompareTable />

  <!-- PRICING -->
  <section class="section bg-raised" id="pricing">
    <div class="container">
      <div class="features-header reveal">
        <div class="label">Pricing</div>
        <h2 class="sec-title">Free APM. Paid <em>intelligence.</em></h2>
        <p style="font-size:17px;color:var(--carbon-300);max-width:580px;margin:0 auto;">Flame graphs, query tracking, and full request profiling are free forever. AI-powered insights start at $29/month.</p>
      </div>
      <Pricing />
    </div>
  </section>

  <section class="section">
    <Faq />
  </section>

  <FoundingMemberCta />

  <!-- FINAL CTA -->
  <section class="section" id="download" style="text-align:center;position:relative;">
    <div class="container reveal">
      <h2 class="sec-title" style="font-size:clamp(32px,4.5vw,56px);letter-spacing:-0.03em;">Stop guessing.<br>Start <em>seeing.</em></h2>
      <p style="font-size:18px;color:var(--carbon-300);max-width:520px;margin:0 auto 40px;">Install WP Flame for free. See your flame graph in 30 seconds. Add AI insights when you're ready.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href={links.wordpressOrg} class="btn-primary">Download from WordPress.org ↓</a>
        <a href={links.sparkTrial} class="btn-ai">✨ Start free trial</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .hero {
    min-height: 100vh; display: flex; flex-direction: column; justify-content: center;
    align-items: center; text-align: center; padding: 140px 40px 100px; position: relative;
  }
  .hero::before {
    content: ''; position: absolute; top: -200px; left: 50%; transform: translateX(-50%);
    width: 1000px; height: 1000px;
    background: radial-gradient(ellipse at center, rgba(240,122,24,0.08) 0%, rgba(232,77,48,0.04) 30%, transparent 60%);
    pointer-events: none;
  }
  .hero::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 120px, rgba(255,255,255,0.012) 120px, rgba(255,255,255,0.012) 121px);
    pointer-events: none;
  }
  .hero-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(240,122,24,0.08); border: 1px solid rgba(240,122,24,0.15);
    border-radius: 100px; padding: 7px 20px 7px 14px;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 500;
    color: var(--flame-400); margin-bottom: 40px; animation: fadeIn 0.8s ease-out;
  }
  .hero-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--flame-400); animation: pulse 2s infinite; }
  .hero h1 {
    font-size: clamp(40px, 6vw, 72px); font-weight: 700; color: white;
    letter-spacing: -0.035em; line-height: 1.08; max-width: 840px;
    margin-bottom: 28px; animation: fadeInUp 0.9s ease-out 0.1s both;
  }
  .hero h1 em { font-family: 'Instrument Serif', serif; font-style: italic; color: var(--flame-400); font-weight: 400; }
  .hero-sub {
    font-size: clamp(17px, 2vw, 20px); color: var(--carbon-300); max-width: 580px;
    margin-bottom: 48px; line-height: 1.6; animation: fadeInUp 0.9s ease-out 0.2s both;
  }
  .hero-actions {
    display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: center;
    animation: fadeInUp 0.9s ease-out 0.3s both;
  }
  .hero-meta {
    margin-top: 48px; display: flex; gap: 40px;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--carbon-400);
    animation: fadeInUp 0.9s ease-out 0.4s both;
  }
  .demo-section { padding: 0 40px 140px; }
  .features-header { text-align: center; margin-bottom: 80px; }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  /* Two halves */
  .two-halves { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; border-radius: 16px; overflow: hidden; }
  .half-card { padding: 48px 40px; }
  .half-free { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px 0 0 16px; }
  .half-ai {
    background: linear-gradient(160deg, rgba(123,92,255,0.06) 0%, rgba(99,68,224,0.02) 100%);
    border: 1px solid rgba(123,92,255,0.12); border-radius: 0 16px 16px 0;
  }
  .half-card .half-label {
    font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;
  }
  .half-free .half-label { color: var(--carbon-400); }
  .half-ai .half-label { color: var(--ai-400); }
  .half-card h3 { font-size: 22px; font-weight: 700; color: white; margin-bottom: 10px; }
  .half-card .half-desc { font-size: 15px; color: var(--carbon-300); margin-bottom: 28px; line-height: 1.6; }
  .half-list { list-style: none; }
  .half-list li {
    padding: 9px 0; font-size: 14px; color: var(--carbon-200);
    border-bottom: 1px solid rgba(255,255,255,0.04); display: flex; align-items: center; gap: 10px;
  }
  .half-list li:last-child { border-bottom: none; }
  .half-free .half-list li::before { content: '✓'; color: var(--insight-400); font-weight: 700; font-size: 13px; }
  .half-ai .half-list li::before { content: '✦'; color: var(--ai-400); font-weight: 700; font-size: 13px; }

  @media (max-width: 900px) {
    .hero { padding: 120px 20px 80px; }
    .hero-meta { flex-direction: column; gap: 8px; }
    .features-grid { grid-template-columns: 1fr; }
    .two-halves { grid-template-columns: 1fr; }
    .half-free { border-radius: 16px 16px 0 0; }
    .half-ai { border-radius: 0 0 16px 16px; }
    .demo-section { padding: 0 20px 100px; }
  }
</style>
