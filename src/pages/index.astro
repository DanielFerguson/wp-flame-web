---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FlameDemo from '../components/FlameDemo.astro';
import Faq from '../components/Faq.astro';
import FoundingMemberCta from '../components/FoundingMemberCta.astro';
import '../styles/global.css';

const workflows = [
  { href: '/use-cases/slow-wp-admin/', label: 'wp-admin and editing', text: 'Investigate slow dashboards, editors, searches, and internal workflows.' },
  { href: '/use-cases/woocommerce-checkout/', label: 'WooCommerce checkout', text: 'Inspect uncached cart, checkout, payment, shipping, and session work.' },
  { href: '/use-cases/external-api/', label: 'External APIs', text: 'Find supported WordPress HTTP API calls delaying a dynamic request.' },
  { href: '/use-cases/plugin-regression/', label: 'Update regressions', text: 'Capture comparable evidence before and after a suspected change.' },
  { href: '/use-cases/rest-ajax/', label: 'REST and AJAX', text: 'Trace eligible application requests that browser page tests do not explain.' },
  { href: '/use-cases/cron-action-scheduler/', label: 'Cron and background work', text: 'Investigate supported scheduled and asynchronous WordPress activity.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WP Flame',
  url: 'https://wpflame.com',
  description: 'A WordPress-native performance flight recorder for dynamic requests.',
};
---

<Base
  title="WP Flame — The Performance Flight Recorder for Dynamic WordPress"
  description="Capture a real dynamic WordPress request, inspect its largest supported measured contributors, and verify whether the next change improved it."
  jsonLd={jsonLd}
>
  <Nav cta="Apply as a design partner" ctaHref="/design-partner/" />

  <main id="main-content">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="hero-pill"><span></span> Paid design-partner programme</div>
          <h1>Bring us the WordPress workflow that is <em>slowing you down.</em></h1>
          <p>
            WP Flame records a bounded dynamic WordPress request, shows the largest
            supported measured contributors, and helps you verify whether the next
            change improved it.
          </p>
          <div class="hero-actions">
            <a href="/design-partner/" class="btn-primary" data-analytics-event="design_partner_cta_clicked" data-analytics-placement="homepage_hero">Apply with a real incident</a>
            <a href="/sample-trace/" class="btn-secondary" data-analytics-event="sample_trace_cta_clicked" data-analytics-placement="homepage_hero">Explore a sample trace</a>
          </div>
          <div class="proof-strip" aria-label="Product principles">
            <span>Local-first</span>
            <span>No server agent required</span>
            <span>Bounded capture</span>
            <span>Built for dynamic WordPress</span>
          </div>
        </div>

        <aside class="incident-card" aria-label="Illustrative diagnosis workflow">
          <div class="incident-topline">
            <span class="status-dot"></span>
            <span>Illustrative workflow</span>
          </div>
          <div class="incident-route">POST /checkout/</div>
          <div class="incident-state">
            <span>Complaint</span>
            <strong>Checkout occasionally stalls</strong>
          </div>
          <div class="incident-path" aria-hidden="true">
            <span>Capture</span><i></i><span>Evidence</span><i></i><span>Verify</span>
          </div>
          <div class="incident-result">
            <span>Likely next action</span>
            <p>Inspect the largest supported WordPress HTTP API span and repeat the same workflow after the change.</p>
          </div>
          <p class="incident-disclaimer">No timing shown here is a product benchmark or a claim about another site.</p>
        </aside>
      </div>
    </section>

    <section class="problem section-tight">
      <div class="container problem-grid">
        <div class="problem-heading reveal">
          <div class="label">The missing evidence</div>
          <h2 class="sec-title">Page-speed tests show the symptom. WP Flame investigates supported contributors inside WordPress.</h2>
        </div>
        <div class="problem-copy reveal">
          <p>
            A slow checkout, admin screen, API request, or cron task is rarely explained
            by a browser score. These requests still execute PHP and often depend on
            plugins, hooks, compatible database activity, and external services.
          </p>
          <p>
            WP Flame is being built to turn that supported request evidence into a
            defensible next action—not to cache pages, optimise assets, or modify a site automatically.
          </p>
          <a href="/product/" class="text-link">Understand the product boundary <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section how-section" id="how-it-works">
      <div class="container">
        <div class="section-heading reveal">
          <div class="label">How it works</div>
          <h2 class="sec-title">From a vague complaint to evidence you can act on.</h2>
        </div>
        <ol class="steps">
          <li class="reveal">
            <span class="step-number">01</span>
            <div>
              <h3>Capture</h3>
              <p>Choose an eligible route or workflow and record a bounded request with an appropriate capture mode.</p>
            </div>
          </li>
          <li class="reveal">
            <span class="step-number">02</span>
            <div>
              <h3>Understand</h3>
              <p>See what was observed, what was unavailable, and which supported measured contributor deserves attention.</p>
            </div>
          </li>
          <li class="reveal">
            <span class="step-number">03</span>
            <div>
              <h3>Act and verify</h3>
              <p>Implement or hand off the next action, then repeat compatible captures to see whether the workflow improved.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section workflows-section">
      <div class="container">
        <div class="section-heading reveal">
          <div class="label">Dynamic requests</div>
          <h2 class="sec-title">Built for work that still executes WordPress.</h2>
          <p class="sec-desc">
            WP Flame is not a PageSpeed replacement. Its useful territory is the
            uncached, logged-in, transactional, API, and background work that remains.
          </p>
        </div>
        <div class="workflow-grid">
          {workflows.map((workflow, index) => (
            <a class="workflow-card reveal" href={workflow.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{workflow.label}</h3>
              <p>{workflow.text}</p>
              <i aria-hidden="true">→</i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section trace-section" id="sample-trace">
      <div class="container trace-heading reveal">
        <div>
          <div class="label">Interactive product direction</div>
          <h2 class="sec-title">Inspect an illustrative request trace.</h2>
        </div>
        <div>
          <p>
            Open a supported span to see its measured duration, attribution, and likely
            next action. The bundled data is synthetic and is not presented as a benchmark.
          </p>
          <a href="/sample-trace/" class="text-link">Open the full sample and limitations <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="trace-wrap">
        <FlameDemo variant="default" showAi={true} />
      </div>
    </section>

    <section class="section verification-section">
      <div class="container verification-grid">
        <div class="verification-copy reveal">
          <div class="label">Verification, not a victory lap</div>
          <h2 class="sec-title">A recommendation matters when the same workflow can be checked again.</h2>
          <p class="sec-desc">
            WP Flame's public-v1 goal is a compatible before/after workflow. It should
            preserve route, capture capability, and evidence thresholds rather than
            compare unrelated traces or imply causation from one sample.
          </p>
          <a href="/docs/quickstart/" class="text-link">Read the intended diagnosis workflow <span aria-hidden="true">→</span></a>
        </div>
        <div class="verification-card reveal" aria-label="Illustrative verification sequence">
          <div class="verification-row">
            <span>Baseline</span>
            <div><strong>Compatible samples captured</strong><small>Same route · same capability set</small></div>
          </div>
          <div class="verification-arrow" aria-hidden="true">↓</div>
          <div class="verification-row">
            <span>Change</span>
            <div><strong>One bounded intervention</strong><small>Implemented or delegated from the evidence</small></div>
          </div>
          <div class="verification-arrow" aria-hidden="true">↓</div>
          <div class="verification-row outcome">
            <span>After</span>
            <div><strong>Evidence reviewed again</strong><small>Improved, unchanged, or inconclusive</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section agency-section">
      <div class="container agency-grid">
        <div class="agency-panel reveal">
          <div class="label">For agencies and freelancers</div>
          <h2 class="sec-title">Turn a vague client complaint into a defensible action plan.</h2>
          <ul>
            <li>Reproduce the slow workflow</li>
            <li>Show the largest supported measured contributor</li>
            <li>Hand the evidence to a developer, host, or plugin vendor</li>
            <li>Repeat compatible captures after the work</li>
          </ul>
          <a href="/use-cases/client-performance-report/" class="btn-secondary">Explore the agency workflow</a>
        </div>
        <blockquote class="agency-quote reveal">
          <span>Before</span>
          <p>“The client says checkout is slow. We think a plugin may be involved.”</p>
          <span>With evidence</span>
          <p>“These compatible captures show the same supported HTTP span dominating the workflow. Here is the next test and the after-capture plan.”</p>
          <footer>Illustrative handoff language—not a customer testimonial.</footer>
        </blockquote>
      </div>
    </section>

    <section class="section trust-section">
      <div class="container">
        <div class="section-heading reveal">
          <div class="label">Trust by design</div>
          <h2 class="sec-title">Limitations should be visible near the decision.</h2>
        </div>
        <div class="trust-grid">
          <article class="reveal"><h3>Local-first direction</h3><p>Trace data is intended to remain in the WordPress installation by default. Any future connected service requires separate disclosure and consent.</p><a href="/privacy/">Data handling →</a></article>
          <article class="reveal"><h3>Capability-aware traces</h3><p>Unavailable database, early-bootstrap, or instrumentor detail is unknown—not zero. Each trace should state what it did and did not capture.</p><a href="/compatibility/">Compatibility and limits →</a></article>
          <article class="reveal"><h3>Evidence before claims</h3><p>Overhead, compatibility, capacity, and performance claims will be published only with dated methodology, environment, samples, and limitations.</p><a href="/benchmarks/">Benchmark methodology →</a></article>
        </div>
      </div>
    </section>

    <FoundingMemberCta />

    <section class="section faq-section-wrap">
      <Faq />
    </section>

    <section class="section final-cta">
      <div class="container final-panel reveal">
        <div>
          <div class="label">Paid design-partner programme</div>
          <h2>Bring the incident. Leave with a clearer next action.</h2>
          <p>Applications require a real dynamic WordPress workflow and someone able to act on or delegate the evidence.</p>
        </div>
        <div class="final-actions">
          <a href="/design-partner/" class="btn-primary" data-analytics-event="design_partner_cta_clicked" data-analytics-placement="homepage_final">Apply with a workflow</a>
          <a href="/sample-trace/" class="btn-secondary" data-analytics-event="sample_trace_cta_clicked" data-analytics-placement="homepage_final">Explore the sample first</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero {
    min-height: min(880px, 100vh);
    display: flex;
    align-items: center;
    padding: 150px 0 90px;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    width: 1100px;
    height: 900px;
    left: 30%;
    top: -350px;
    background: radial-gradient(ellipse, rgba(240,122,24,.12), rgba(232,77,48,.045) 32%, transparent 68%);
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(330px, .65fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: center;
    position: relative;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border: 1px solid rgba(240,122,24,.22);
    border-radius: 999px;
    color: var(--flame-300);
    background: rgba(240,122,24,.07);
    font: 500 11px 'JetBrains Mono', monospace;
    letter-spacing: .04em;
    margin-bottom: 26px;
  }

  .hero-pill span { width: 6px; height: 6px; border-radius: 50%; background: var(--flame-400); box-shadow: 0 0 18px var(--flame-400); }

  .hero h1 {
    color: white;
    font-size: clamp(46px, 6vw, 78px);
    line-height: 1.01;
    letter-spacing: -.052em;
    max-width: 860px;
  }

  .hero h1 em { color: var(--flame-300); font-family: 'Instrument Serif', serif; font-weight: 400; }
  .hero-copy > p { color: var(--carbon-200); font-size: clamp(18px, 2vw, 21px); line-height: 1.65; max-width: 720px; margin: 30px 0 38px; }
  .hero-actions, .final-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .proof-strip { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 42px; }
  .proof-strip span { color: var(--carbon-200); font: 500 11px 'JetBrains Mono', monospace; position: relative; padding-left: 14px; }
  .proof-strip span::before { content: ''; position: absolute; left: 0; top: .55em; width: 4px; height: 4px; border-radius: 50%; background: var(--flame-400); }

  .incident-card { padding: 28px; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: linear-gradient(155deg, rgba(255,255,255,.05), rgba(255,255,255,.018)); box-shadow: 0 40px 100px rgba(0,0,0,.4); }
  .incident-topline { display: flex; align-items: center; gap: 9px; color: var(--carbon-200); font: 500 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--flame-400); }
  .incident-route { color: white; font: 600 18px 'JetBrains Mono', monospace; margin: 28px 0; padding-bottom: 22px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .incident-state span, .incident-result span { color: var(--carbon-300); font: 500 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; display: block; margin-bottom: 6px; }
  .incident-state strong { color: white; font-size: 16px; }
  .incident-path { display: grid; grid-template-columns: auto 1fr auto 1fr auto; gap: 8px; align-items: center; margin: 26px 0; color: var(--carbon-200); font: 500 10px 'JetBrains Mono', monospace; }
  .incident-path i { height: 1px; background: linear-gradient(90deg,var(--flame-500),rgba(240,122,24,.15)); }
  .incident-result { padding: 18px; border-radius: 11px; background: rgba(240,122,24,.07); border: 1px solid rgba(240,122,24,.14); }
  .incident-result p { color: var(--carbon-100); font-size: 13px; line-height: 1.55; }
  .incident-disclaimer { color: var(--carbon-300); font-size: 10px; line-height: 1.5; margin-top: 16px; }

  .section-tight { padding: 105px 0; }
  .problem { background: var(--carbon-800); border-block: 1px solid rgba(255,255,255,.05); }
  .problem-grid { display: grid; grid-template-columns: 1fr .8fr; gap: 90px; }
  .problem-copy p { color: var(--carbon-200); font-size: 17px; margin-bottom: 20px; }
  .text-link { color: var(--flame-300); font-weight: 600; text-decoration: none; display: inline-flex; gap: 7px; margin-top: 8px; }
  .text-link:hover { color: white; }
  .section-heading { max-width: 760px; margin-bottom: 54px; }

  .how-section { padding-top: 120px; }
  .steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); list-style: none; gap: 18px; }
  .steps li { min-height: 250px; padding: 30px; border: 1px solid rgba(255,255,255,.08); border-radius: 16px; background: rgba(255,255,255,.025); }
  .step-number { color: var(--flame-300); font: 600 11px 'JetBrains Mono', monospace; }
  .steps h3 { color: white; font-size: 24px; margin: 48px 0 12px; }
  .steps p { color: var(--carbon-300); }

  .workflows-section { padding-top: 80px; }
  .workflow-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }
  .workflow-card { position: relative; min-height: 215px; padding: 26px; border: 1px solid rgba(255,255,255,.07); border-radius: 14px; background: rgba(255,255,255,.02); text-decoration: none; transition: border-color .2s, transform .2s, background .2s; }
  .workflow-card > span { color: var(--carbon-300); font: 500 10px 'JetBrains Mono', monospace; }
  .workflow-card h3 { color: white; font-size: 18px; margin: 28px 0 10px; }
  .workflow-card p { color: var(--carbon-300); font-size: 14px; }
  .workflow-card i { position: absolute; right: 22px; bottom: 18px; color: var(--flame-300); font-style: normal; }
  .workflow-card:hover { border-color: rgba(240,122,24,.3); background: rgba(240,122,24,.035); transform: translateY(-2px); }

  .trace-section { background: linear-gradient(180deg,transparent,var(--carbon-800) 18%,var(--carbon-800) 82%,transparent); }
  .trace-heading { display: grid; grid-template-columns: 1fr .65fr; gap: 70px; align-items: end; margin-bottom: 50px; }
  .trace-heading p { color: var(--carbon-200); }
  .trace-wrap { max-width: 1200px; margin: 0 auto; padding-inline: 32px; }

  .verification-section { padding-top: 110px; }
  .verification-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 90px; align-items: center; }
  .verification-card { padding: 30px; border: 1px solid rgba(255,255,255,.09); border-radius: 18px; background: rgba(255,255,255,.025); }
  .verification-row { display: grid; grid-template-columns: 86px 1fr; gap: 18px; padding: 19px; border-radius: 12px; background: rgba(255,255,255,.035); }
  .verification-row > span { color: var(--flame-300); font: 600 10px 'JetBrains Mono', monospace; text-transform: uppercase; }
  .verification-row strong { color: white; display: block; font-size: 15px; }
  .verification-row small { color: var(--carbon-300); display: block; margin-top: 4px; }
  .verification-row.outcome { border: 1px solid rgba(52,212,152,.18); background: rgba(52,212,152,.045); }
  .verification-arrow { color: var(--carbon-300); margin: 8px 0 8px 40px; }

  .agency-section { background: var(--carbon-800); border-block: 1px solid rgba(255,255,255,.05); }
  .agency-grid { display: grid; grid-template-columns: 1fr .8fr; gap: 80px; align-items: center; }
  .agency-panel ul { list-style: none; margin: 30px 0; }
  .agency-panel li { color: var(--carbon-100); padding: 10px 0 10px 26px; position: relative; }
  .agency-panel li::before { content: '→'; color: var(--flame-300); position: absolute; left: 0; }
  .agency-quote { margin: 0; padding: 32px; border-radius: 16px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); }
  .agency-quote span { color: var(--flame-300); font: 600 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .agency-quote p { color: white; font-size: 17px; margin: 9px 0 28px; }
  .agency-quote footer { color: var(--carbon-300); font-size: 11px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 16px; }

  .trust-section { padding-top: 120px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .trust-grid article { padding: 30px; border-top: 2px solid var(--flame-500); background: rgba(255,255,255,.022); }
  .trust-grid h3 { color: white; font-size: 18px; margin-bottom: 12px; }
  .trust-grid p { color: var(--carbon-300); font-size: 14px; min-height: 116px; }
  .trust-grid a { color: var(--flame-300); font-size: 13px; font-weight: 600; }

  .faq-section-wrap { padding-top: 100px; }
  .final-cta { padding-top: 70px; }
  .final-panel { display: flex; justify-content: space-between; align-items: center; gap: 50px; padding: clamp(32px,5vw,58px); border: 1px solid rgba(240,122,24,.22); border-radius: 22px; background: radial-gradient(circle at 90% 10%,rgba(240,122,24,.12),transparent 36%),rgba(255,255,255,.025); }
  .final-panel h2 { color: white; font-size: clamp(30px,4.5vw,48px); line-height: 1.08; max-width: 720px; }
  .final-panel p { color: var(--carbon-300); margin-top: 14px; max-width: 690px; }
  .final-actions { min-width: 250px; flex-direction: column; }
  .final-actions a { justify-content: center; text-align: center; }

  @media (max-width: 950px) {
    .hero { min-height: auto; }
    .hero-layout, .problem-grid, .trace-heading, .verification-grid, .agency-grid { grid-template-columns: 1fr; }
    .hero-layout { gap: 55px; }
    .problem-grid, .verification-grid, .agency-grid { gap: 45px; }
    .steps, .workflow-grid, .trust-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .trace-heading { gap: 20px; }
    .final-panel { align-items: flex-start; flex-direction: column; }
    .final-actions { width: 100%; }
  }

  @media (max-width: 650px) {
    .hero { padding-top: 125px; }
    .hero h1 { font-size: clamp(42px,13vw,58px); }
    .proof-strip { flex-direction: column; }
    .steps, .workflow-grid, .trust-grid { grid-template-columns: 1fr; }
    .steps li { min-height: 210px; }
    .trace-wrap { padding-inline: 16px; }
    .incident-card { padding: 22px; }
    .verification-row { grid-template-columns: 1fr; }
  }
</style>
